t="k_tempo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="GitOps sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c7" target="ns"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="987"/><mxPoint x="350" y="610"/></Array></mxGeometry></mxCell><mxCell id="envs" value="&lt;b&gt;Environments:&lt;/b&gt; dev (Docker Compose / kind / k3d) -&gt; staging -&gt; prod. The same image digest is promoted by a PR to the GitOps repo (Argo CD pulls the signed digest from the registry); production requires manual approval. Separate namespaces or clusters per environment; secrets never in Git." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="1100" width="1450" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 - Async deployment workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Asynchronous, idempotent deployment workflow" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontFamily=Helvetica;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Durable intent before external side effects | one transaction per state change | reconciler repairs partial failure" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="lane_UI" value="Angular UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f3f8fe;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="260" height="1120" as="geometry"/></mxCell><mxCell id="lane_API" value="API process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f4faf3;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="260" height="1120" as="geometry"/></mxCell><mxCell id="lane_DB" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fffbea;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="260" height="1120" as="geometry"/></mxCell><mxCell id="lane_WK" value="Worker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff8ef;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="260" height="1120" as="geometry"/></mxCell><mxCell id="lane_RT" value="External model runtime" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1100" y="80" width="260" height="1120" as="geometry"/></mxCell><mxCell id="lane_RC" value="Reconciler (scheduled)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff8ef;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1370" y="80" width="260" height="1120" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1&lt;/b&gt;  POST /deployments&lt;br&gt;Idempotency-Key, X-Correlation-ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_UI"><mxGeometry x="15" y="50" width="230" height="70" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt;  AuthZ (role + env policy),&lt;br&gt;idempotency lookup, policy check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_API"><mxGeometry x="15" y="142" width="230" height="70" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3&lt;/b&gt;  ONE transaction: deployment (REQUESTED)&lt;br&gt;+ audit + outbox + idempotency record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_DB"><mxGeometry x="15" y="234" width="230" height="70" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4&lt;/b&gt;  return 202 Accepted&lt;br&gt;+ Location header" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_API"><mxGeometry x="15" y="326" width="230" height="70" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5&lt;/b&gt;  claim outbox row&lt;br&gt;SKIP LOCKED, lease + heartbeat" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_WK"><mxGeometry x="15" y="418" width="230" height="70" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6&lt;/b&gt;  attempt row committed BEFORE the call&lt;br&gt;VALIDATING then DEPLOYING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_DB"><mxGeometry x="15" y="510" width="230" height="70" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7&lt;/b&gt;  deploy(deployment_id)&lt;br&gt;deployment_id = external idempotency key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_RT"><mxGeometry x="15" y="602" width="230" height="70" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8&lt;/b&gt;  verify readiness: status()&lt;br&gt;circuit breaker, timeouts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_WK"><mxGeometry x="15" y="694" width="230" height="70" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9&lt;/b&gt;  ONE transaction: SUCCEEDED + binding CAS&lt;br&gt;(row_version) + stage + audit + outbox" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_DB"><mxGeometry x="15" y="786" width="230" height="70" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;10&lt;/b&gt;  poll GET /deployments/{id}&lt;br&gt;until terminal state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_UI"><mxGeometry x="15" y="878" width="230" height="70" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;F1&lt;/b&gt;  on error: classify failure&lt;br&gt;POLICY, VALIDATION, TRANSIENT, ..." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_WK"><mxGeometry x="15" y="980" width="230" height="70" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;F2&lt;/b&gt;  FAILED + audit; TRANSIENT: backoff&lt;br&gt;retry as attempt n+1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_DB"><mxGeometry x="15" y="980" width="230" height="70" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;R1&lt;/b&gt;  scan attempts stuck in DEPLOYING&lt;br&gt;longer than timeout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_RC"><mxGeometry x="15" y="786" width="230" height="70" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;R2&lt;/b&gt;  status(deployment_id)&lt;br&gt;is the model actually live?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_RT"><mxGeometry x="15" y="878" width="230" height="70" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;R3&lt;/b&gt;  converge PostgreSQL via CAS:&lt;br&gt;SUCCEEDED, or FAILED + undeploy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane_RC"><mxGeometry x="15" y="980" width="230" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="error / timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s8" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="why" value="&lt;b&gt;Why it is safe:&lt;/b&gt; a crash after the runtime call but before step 9 leaves a durable attempt row (step 6). The reconciler (R1-R3) asks the runtime for the truth and converges the database. Repeating step 7 is harmless because the runtime treats deployment_id as an idempotency key." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="1210" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 - State machines and invariants"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Domain state machines and invariants" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontFamily=Helvetica;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="State changes happen only through explicit transition tables; guards are unit-tested without a database" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="h1" value="Model version lifecycle" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontFamily=Helvetica;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="85" width="400" height="24" as="geometry"/></mxCell><mxCell id="v0" value="&lt;b&gt;DRAFT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;VALIDATED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;APPROVED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;STAGING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="830" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;PRODUCTION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1100" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;ARCHIVED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1370" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="e1" value="validation&lt;br&gt;checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v0" target="v1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="approver differs&lt;br&gt;from registrant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="successful STAGING&lt;br&gt;deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="successful PROD deploy&lt;br&gt;(approved + staged)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="superseded or&lt;br&gt;undeployed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rej" value="REJECTED approval keeps the version in VALIDATED&lt;br&gt;(audit event recorded, resubmission allowed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="420" height="50" as="geometry"/></mxCell><mxCell id="anyarch" value="Any non-live stage can be ARCHIVED&lt;br&gt;(a PRODUCTION version only after it is superseded or undeployed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="560" height="50" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="anyarch" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="rej" target="v1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="h2" value="Deployment state machine" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontFamily=Helvetica;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="400" height="24" as="geometry"/></mxCell><mxCell id="d0" value="&lt;b&gt;REQUESTED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="130" height="60" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;VALIDATING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="480" width="130" height="60" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;DEPLOYING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="130" height="60" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;SUCCEEDED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="830" y="480" width="130" height="60" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;ROLLED_BACK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1100" y="480" width="130" height="60" as="geometry"/></mxCell><mxCell id="e8" value="worker claims&lt;br&gt;outbox row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="artifact, policy,&lt;br&gt;runtime checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="runtime ready&lt;br&gt;+ binding CAS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="superseded by&lt;br&gt;rollback deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dfail" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;failure_class recorded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;arcSize=30;" vertex="1" parent="1"><mxGeometry x="405" y="640" width="170" height="70" as="geometry"/></mxCell><mxCell id="e12" value="classified failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="dfail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="classified failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="dfail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="retry: new attempt&lt;br&gt;(re-validates everything)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="dfail" target="d0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tbl" value="&lt;b&gt;Failure classes&lt;/b&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px'&gt;&lt;tr&gt;&lt;th&gt;Class&lt;/th&gt;&lt;th&gt;Examples&lt;/th&gt;&lt;th&gt;Retry&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;POLICY&lt;/td&gt;&lt;td&gt;not approved, no staging deploy&lt;/td&gt;&lt;td&gt;No, until cause changes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VALIDATION&lt;/td&gt;&lt;td&gt;artifact missing, runtime incompatible&lt;/td&gt;&lt;td&gt;No, until fixed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TRANSIENT&lt;/td&gt;&lt;td&gt;runtime timeout, 5xx, network&lt;/td&gt;&lt;td&gt;Automatic, then manual&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PERMANENT_RUNTIME&lt;/td&gt;&lt;td&gt;runtime rejects the model&lt;/td&gt;&lt;td&gt;Manual only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;INTERNAL&lt;/td&gt;&lt;td&gt;platform bug, DB error&lt;/td&gt;&lt;td&gt;After investigation&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="760" height="200" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;Invariants (enforced by the database, not by hope)&lt;/b&gt;&lt;br&gt;- One in-flight deployment per (tenant, model, environment): partial unique index.&lt;br&gt;- Environment binding and version rows change only by compare-and-swap on row_version.&lt;br&gt;- Audit event is written in the same transaction as the state change.&lt;br&gt;- Rollback target must be a previously SUCCEEDED, approved, non-archived version in the same environment." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="740" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>