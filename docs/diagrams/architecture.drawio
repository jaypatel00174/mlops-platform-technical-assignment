<mxfile host="app.diagrams.net" agent="kiro" version="24.0.0"><diagram id="page1" name="1 - Logical architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MLOps Platform - Logical Architecture" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontFamily=Helvetica;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Modular monolith  |  ports and adapters  |  transactional outbox  |  platform agnostic  |  standards-based identity and telemetry" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="idp" value="&lt;b&gt;OIDC Identity Provider&lt;/b&gt;&lt;br&gt;Keycloak / Entra ID / Okta / any OIDC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="85" width="260" height="70" as="geometry"/></mxCell><mxCell id="users" value="Users (RBAC roles)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f3f8fe;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="170" height="520" as="geometry"/></mxCell><mxCell id="act0" value="ML Engineer&lt;br&gt;&lt;i&gt;ml-engineer&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="users"><mxGeometry x="65" y="45" width="40" height="70" as="geometry"/></mxCell><mxCell id="act1" value="Approver&lt;br&gt;&lt;i&gt;approver&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="users"><mxGeometry x="65" y="160" width="40" height="70" as="geometry"/></mxCell><mxCell id="act2" value="Release Manager&lt;br&gt;&lt;i&gt;release-manager&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="users"><mxGeometry x="65" y="275" width="40" height="70" as="geometry"/></mxCell><mxCell id="act3" value="SRE / Operator&lt;br&gt;&lt;i&gt;viewer, admin&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="users"><mxGeometry x="65" y="390" width="40" height="70" as="geometry"/></mxCell><mxCell id="spa" value="Angular SPA (nginx, static)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f3f8fe;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="230" y="290" width="190" height="300" as="geometry"/></mxCell><mxCell id="spa1" value="&lt;b&gt;Feature modules&lt;/b&gt;&lt;br&gt;models, versions, deployments,&lt;br&gt;monitoring, timeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="spa"><mxGeometry x="15" y="40" width="160" height="70" as="geometry"/></mxCell><mxCell id="spa2" value="&lt;b&gt;Typed API client&lt;/b&gt;&lt;br&gt;generated from OpenAPI&lt;br&gt;+ view-model mappers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="spa"><mxGeometry x="15" y="125" width="160" height="70" as="geometry"/></mxCell><mxCell id="spa3" value="&lt;b&gt;Core&lt;/b&gt;&lt;br&gt;auth, correlation-ID and&lt;br&gt;error interceptors,&lt;br&gt;runtime config" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="spa"><mxGeometry x="15" y="210" width="160" height="70" as="geometry"/></mxCell><mxCell id="ingress" value="&lt;b&gt;Ingress / API Gateway&lt;/b&gt;&lt;br&gt;TLS, WAF, rate limits,&lt;br&gt;size limits, CORS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="370" width="140" height="140" as="geometry"/></mxCell><mxCell id="agents" value="&lt;b&gt;Metric agents / inference gateways&lt;/b&gt;&lt;br&gt;push batched metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="760" width="190" height="80" as="geometry"/></mxCell><mxCell id="plane" value="Application plane - modular monolith (one image, two entrypoints)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f4faf3;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="620" height="870" as="geometry"/></mxCell><mxCell id="api" value="API process (FastAPI) - stateless, horizontally scaled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f4faf3;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="plane"><mxGeometry x="20" y="45" width="580" height="330" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;Cross-cutting middleware&lt;/b&gt;&lt;br&gt;AuthN (OIDC/JWT) | RBAC | Correlation-ID | Idempotency-Key | Validation | RFC 7807 errors" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="api"><mxGeometry x="20" y="40" width="540" height="55" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;Registry&lt;/b&gt;&lt;br&gt;models, versions,&lt;br&gt;lifecycle stage,&lt;br&gt;artifact refs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="api"><mxGeometry x="20" y="110" width="125" height="110" as="geometry"/></mxCell><mxCell id="gov" value="&lt;b&gt;Governance&lt;/b&gt;&lt;br&gt;approvals, promotion&lt;br&gt;policy, RBAC,&lt;br&gt;audit log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="api"><mxGeometry x="160" y="110" width="125" height="110" as="geometry"/></mxCell><mxCell id="dep" value="&lt;b&gt;Deployment&lt;/b&gt;&lt;br&gt;requests, retry, rollback,&lt;br&gt;env bindings,&lt;br&gt;idempotency, outbox" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="api"><mxGeometry x="300" y="110" width="125" height="110" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;metric ingest, rollups,&lt;br&gt;health status,&lt;br&gt;version compare" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="api"><mxGeometry x="440" y="110" width="125" height="110" as="geometry"/></mxCell><mxCell id="modnote" value="Each module is layered: api, application, domain, infrastructure. Cross-module calls go only through application services (enforced by import-linter in CI)." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="api"><mxGeometry x="20" y="235" width="540" height="70" as="geometry"/></mxCell><mxCell id="ports" value="Ports and adapters (selected by configuration, contract-tested)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="plane"><mxGeometry x="20" y="395" width="580" height="110" as="geometry"/></mxCell><mxCell id="p_idp" value="IdentityProvider&lt;br&gt;&lt;i&gt;oidc_jwt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="ports"><mxGeometry x="15" y="43" width="102" height="56" as="geometry"/></mxCell><mxCell id="p_q" value="TaskQueue&lt;br&gt;&lt;i&gt;db_outbox&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="ports"><mxGeometry x="129" y="43" width="102" height="56" as="geometry"/></mxCell><mxCell id="p_m" value="MetricsStore&lt;br&gt;&lt;i&gt;sql&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="ports"><mxGeometry x="243" y="43" width="102" height="56" as="geometry"/></mxCell><mxCell id="p_a" value="ArtifactStore&lt;br&gt;&lt;i&gt;filesystem, s3_api&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="ports"><mxGeometry x="357" y="43" width="102" height="56" as="geometry"/></mxCell><mxCell id="p_r" value="ModelRuntime&lt;br&gt;&lt;i&gt;simulated, kserve...&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="ports"><mxGeometry x="471" y="43" width="102" height="56" as="geometry"/></mxCell><mxCell id="worker" value="Worker process (same image) - scaled on queue depth" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff8ef;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="plane"><mxGeometry x="20" y="525" width="580" height="320" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Outbox relay / dispatcher&lt;/b&gt;&lt;br&gt;FOR UPDATE SKIP LOCKED&lt;br&gt;lease + heartbeat" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="worker"><mxGeometry x="15" y="50" width="175" height="100" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Deployment executor&lt;/b&gt;&lt;br&gt;validate, deploy, verify&lt;br&gt;backoff + jitter&lt;br&gt;circuit breaker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="worker"><mxGeometry x="202" y="50" width="175" height="100" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Reconciler&lt;/b&gt;&lt;br&gt;stuck DEPLOYING: ask runtime,&lt;br&gt;converge DB to reality" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="worker"><mxGeometry x="389" y="50" width="175" height="100" as="geometry"/></mxCell><mxCell id="w4" value="&lt;b&gt;Metric aggregator and drift evaluator&lt;/b&gt;&lt;br&gt;hourly / daily rollups, status rules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="worker"><mxGeometry x="15" y="170" width="270" height="90" as="geometry"/></mxCell><mxCell id="w5" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;cron-style jobs, advisory-lock leader election" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="worker"><mxGeometry x="300" y="170" width="264" height="90" as="geometry"/></mxCell><mxCell id="data" value="Data plane" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fffbea;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1300" y="190" width="250" height="400" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 16 (primary)&lt;/b&gt;&lt;br&gt;module schemas, outbox,&lt;br&gt;idempotency, audit (append-only),&lt;br&gt;partitioned metrics" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="data"><mxGeometry x="25" y="45" width="200" height="125" as="geometry"/></mxCell><mxCell id="pgr" value="&lt;b&gt;Read replica(s)&lt;/b&gt;&lt;br&gt;reporting, dashboards" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="data"><mxGeometry x="25" y="195" width="200" height="90" as="geometry"/></mxCell><mxCell id="art" value="&lt;b&gt;Artifact store&lt;/b&gt;&lt;br&gt;S3-API / filesystem" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="data"><mxGeometry x="25" y="305" width="200" height="80" as="geometry"/></mxCell><mxCell id="rt" value="&lt;b&gt;External model runtime&lt;/b&gt;&lt;br&gt;KServe, Seldon, Triton,&lt;br&gt;SageMaker, Vertex&lt;br&gt;&lt;i&gt;(simulated in this repo)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1610" y="610" width="210" height="100" as="geometry"/></mxCell><mxCell id="obs" value="Observability - vendor-neutral standards (OTLP, Prometheus format, JSON logs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f2f9;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="230" y="1110" width="1560" height="270" as="geometry"/></mxCell><mxCell id="otel" value="&lt;b&gt;OpenTelemetry Collector&lt;/b&gt;&lt;br&gt;receives OTLP, fans out" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="obs"><mxGeometry x="40" y="105" width="200" height="80" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;metrics, SLO rules" style="rounded=1;whiteSpace=wrap;