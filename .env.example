# Copy to .env for local development: `make bootstrap` does this for you.
# Every application setting is an environment variable, validated at startup
# (see backend/src/mlops/platform/config.py). A test keeps this file in sync with the settings.
# The values below are DEVELOPMENT DEFAULTS ONLY. Never use them in a shared environment.

# --- application -------------------------------------------------------------
# local | test | staging | production. Production refuses development credentials.
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DEFAULT_TENANT=default

# --- database ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://mlops:mlops@localhost:5432/mlops

# --- adapters (see docs/architecture.md, ports and adapters) -------------------
RUNTIME_BACKEND=simulated
QUEUE_BACKEND=db_outbox
ARTIFACT_BACKEND=filesystem
METRICS_BACKEND=sql
ARTIFACT_ROOT=var/artifacts

# --- identity ------------------------------------------------------------------
# dev_jwt: HMAC-signed development tokens (local use and tests only).
# oidc_jwt: tokens from any OIDC provider, verified against its JWKS. Required in production.
AUTH_BACKEND=dev_jwt
DEV_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Claim that holds the caller's roles (Keycloak realm roles may need a different claim).
OIDC_ROLES_CLAIM=roles

# --- docker compose only (not read by the application) -------------------------
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=mlops
DB_PORT=5432
